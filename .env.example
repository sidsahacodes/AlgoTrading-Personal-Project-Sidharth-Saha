# Copy to `.env` (git-ignored) and edit. Every variable is optional.

# Where caches (parquet), the paper ledger and results live. Default: <repo>/data
# MR_DATA_ROOT=C:/Users/YOUR_NAME/Desktop/Personal Modeling Projects/Algorithmic Trading/data

# Regime preset from configs/regimes.yaml. Default: strategy.yaml `regime` (baseline)
# MR_REGIME=baseline

# yahoo | crsp. CRSP needs WRDS_USERNAME and `pip install wrds`; use a separate MR_DATA_ROOT for it.
# MR_PRICE_SOURCE=yahoo
# WRDS_USERNAME=your_wrds_username

# paper | ibkr. Default: strategy.yaml `broker` (paper). Set ibkr only when TWS is ready.
# MR_BROKER=paper
